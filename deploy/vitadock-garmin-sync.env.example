# Copy to /etc/vitadock-garmin-sync.env (chmod 600, owned by root).

# Required: OAuth consumer credentials of the VitaDock+ app (see README).
VITADOCK_CONSUMER_KEY=
VITADOCK_CONSUMER_SECRET=

# Optional: only needed if the stored VitaDock token is ever revoked; the
# service then logs in again by itself. Leave empty to rely on `login`.
VITADOCK_EMAIL=
VITADOCK_PASSWORD=
# eu (cloud.vitadock.com, default) or asia
VITADOCK_SERVER=eu

# Optional: only needed until the first `login` stores Garmin tokens.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Timezone your measurements are taken in.
VDGS_TIMEZONE=Europe/Amsterdam
# utc (default) or wallclock, see README "Timestamps".
VDGS_TIMESTAMPS=utc
# Skip measurements older than this on the first run (ISO date), e.g. to avoid
# duplicating history that Garmin already has. Empty = sync everything.
VDGS_SYNC_SINCE=
# Which VitaDock modules to sync: targetscales (weight/body composition),
# cardiodocks (blood pressure).
VDGS_MODULES=targetscales,cardiodocks
